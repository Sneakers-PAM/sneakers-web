{
  "name": "sneakers-web",
  "version": "0.0.0",
  "description": "Sneakers web apps in one repo: staff, admin, appliance admin, maintenance, docs and the UI kit",
  "author": "The Sneakers-PAM Authors",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sneakers-PAM/sneakers-web.git"
  },
  "homepage": "https://github.com/Sneakers-PAM/sneakers-web#readme",
  "bugs": {
    "url": "https://github.com/Sneakers-PAM/sneakers-web/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sneakers-web/staff",
    "dev:mock": "npm run dev:mock -w @sneakers-web/staff",
    "dev:admin": "npm run dev -w @sneakers-web/admin",
    "dev:admin:mock": "npm run dev:mock -w @sneakers-web/admin",
    "build": "npm run build --workspaces --if-present",
    "build:mock": "npm run build:mock --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:generate": "bash scripts/schema-generate.sh",
    "check:no-mock": "node scripts/check-no-mock.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:mock && npm run check:no-mock && npm run check:assets"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.9",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@the-rabbit-hole/eslint-config": "^0.7.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "graphql": "^17.0.2",
    "jsdom": "^30.1.1",
    "prettier": "3.9.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
