{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "paths": {
      "#ui/*": ["./packages/ui/src/*"],
      "#api/*": ["./packages/api-client/src/*"],
      "#shell/*": ["./packages/shell/src/*"],
      "#gw/*": ["./node_modules/@sneakers-pam/mock-server/packages/gateway-client/src/*"],
      "#mock/*": ["./node_modules/@sneakers-pam/mock-server/packages/mock-gateway/src/*"],
      "@sneakers-pam/gateway-client": [
        "./node_modules/@sneakers-pam/mock-server/packages/gateway-client/src/index.ts"
      ],
      "@sneakers-web/edge.server": ["./packages/api-client/src/edge/live.server.ts"]
    }
  },
  "files": ["./types/env.d.ts"]
}
