# Resolve peer-dependency conflicts the same way locally and in CI. If an
# `overrides` block (or this flag) makes install work locally, CI must not be
# stricter -- assume it was validated before pushing.
legacy-peer-deps=true

# npm 12 refuses tarball URLs unless asked. The mock server is a root dev dependency pinned by
# commit; "root" allows that and still refuses tarball URLs deeper in the tree.
allow-remote=root
